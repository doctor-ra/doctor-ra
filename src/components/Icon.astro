---
import sunRaw from "lucide-static/icons/sun.svg?raw";
import moonRaw from "lucide-static/icons/moon.svg?raw";
import mailRaw from "lucide-static/icons/mail.svg?raw";
import rssRaw from "lucide-static/icons/rss.svg?raw";
import menuRaw from "lucide-static/icons/menu.svg?raw";
import xRaw from "lucide-static/icons/x.svg?raw";
import arrowRightRaw from "lucide-static/icons/arrow-right.svg?raw";
import arrowLeftRaw from "lucide-static/icons/arrow-left.svg?raw";
import externalLinkRaw from "lucide-static/icons/external-link.svg?raw";
import calendarRaw from "lucide-static/icons/calendar.svg?raw";
import clockRaw from "lucide-static/icons/clock.svg?raw";

// GitHub's mark isn't in lucide (brand icons were dropped); this is the standard open-source octocat path.
const githubRaw = `<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="currentColor"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>`;

const icons = {
  github: githubRaw,
  sun: sunRaw,
  moon: moonRaw,
  mail: mailRaw,
  rss: rssRaw,
  menu: menuRaw,
  x: xRaw,
  "arrow-right": arrowRightRaw,
  "arrow-left": arrowLeftRaw,
  "external-link": externalLinkRaw,
  calendar: calendarRaw,
  clock: clockRaw,
} satisfies Record<string, string>;

export type IconName = keyof typeof icons;

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 20, class: className = "" } = Astro.props;
const svg = icons[name];
---

<span
  class:list={["icon-wrap inline-block shrink-0", className]}
  style={{ width: `${size}px`, height: `${size}px` }}
  set:html={svg}
/>
