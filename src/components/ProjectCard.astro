---
import type { Project } from "../data/projects";
import Icon from "./Icon.astro";

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<div
  class="rounded-xl border border-border p-5 transition-all duration-150 ease-out hover:-translate-y-0.5 hover:border-accent/50"
>
  <div class="flex items-start justify-between gap-4">
    <h3 class="font-semibold text-text">{project.title}</h3>
    <span class="shrink-0 text-xs text-text-muted">{project.year}</span>
  </div>
  <p class="mt-2 text-sm text-text-muted">{project.description}</p>
  <div class="mt-3 flex flex-wrap gap-2">
    {
      project.tech.map((t) => (
        <span class="rounded-full border border-border px-2.5 py-0.5 text-xs text-text-muted">
          {t}
        </span>
      ))
    }
  </div>
  <div class="mt-4 flex items-center gap-4">
    {
      project.github && (
        <a
          href={project.github}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-sm text-text-muted no-underline hover:text-accent"
        >
          <Icon name="github" size={16} />
          Code
        </a>
      )
    }
    {
      project.demo && (
        <a
          href={project.demo}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-sm text-text-muted no-underline hover:text-accent"
        >
          <Icon name="external-link" size={16} />
          Demo
        </a>
      )
    }
  </div>
</div>
