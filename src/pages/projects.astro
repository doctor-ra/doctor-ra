---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { site } from "../data/site";
import { projects } from "../data/projects";
---

<BaseLayout
  title={`Projects · ${site.name}`}
  description="Research, tools, and side projects — spanning neuroscience data analysis and software."
>
  <div class="mx-auto max-w-3xl px-6 py-16">
    <h1 class="text-2xl font-semibold tracking-tight text-text">Projects</h1>
    <p class="mt-3 text-text-muted">
      A mix of research work, small tools, and things I built while learning to code.
    </p>

    <div class="mt-8 flex flex-col gap-4">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>

    <p class="mt-10 text-sm text-text-muted">
      More on my <a
        href={site.github}
        target="_blank"
        rel="noopener noreferrer"
        class="text-accent underline hover:text-accent-hover"
      >GitHub</a>.
    </p>
  </div>
</BaseLayout>
