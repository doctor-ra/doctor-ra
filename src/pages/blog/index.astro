---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { site } from "../../data/site";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout
  title={`Blog · ${site.name}`}
  description="Occasional notes on medicine, neuroscience, and code."
>
  <div class="mx-auto max-w-2xl px-6 py-16">
    <h1 class="text-2xl font-semibold tracking-tight text-text">Blog</h1>
    <p class="mt-3 text-text-muted">Occasional notes on medicine, neuroscience, and code.</p>

    <div class="mt-8 flex flex-col gap-4">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </div>
</BaseLayout>
