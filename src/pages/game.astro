---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
---

<BaseLayout
  title={`Game · ${site.name}`}
  description="Synapse Runner — a tiny browser game. You're a nerve impulse: jump the blockers and chase the high score."
>
  <div class="mx-auto max-w-3xl px-6 py-16">
    <h1 class="text-2xl font-semibold tracking-tight text-text">Synapse Runner</h1>
    <p class="mt-3 text-text-muted">
      You're a nerve impulse racing down an axon. Press <kbd>Space</kbd> or tap the canvas to
      jump the blockers. The longer you last, the faster it gets.
    </p>

    <canvas
      id="game-canvas"
      aria-label="Synapse Runner game"
      class="mt-8 block w-full rounded-xl border border-border bg-bg-elevated"
      style="aspect-ratio: 640 / 240; touch-action: none;"></canvas>

    <div class="mt-3 flex items-center justify-between text-sm text-text-muted">
      <span>Score: <b id="hud-score" class="font-semibold text-text">0</b></span>
      <span>Best: <b id="hud-best" class="font-semibold text-text">0</b></span>
    </div>

    <div id="gameover-panel" class="mt-6 hidden rounded-xl border border-border bg-bg-elevated p-5">
      <p class="font-semibold text-text">Run over! Score: <span id="final-score">0</span></p>
      <div id="save-row" class="mt-3 flex flex-wrap items-center gap-2">
        <label for="player-name" class="text-sm text-text-muted">Name for the board:</label>
        <input
          id="player-name"
          maxlength="20"
          placeholder="e.g. Rohit"
          class="rounded-md border border-border bg-bg px-3 py-1.5 text-sm text-text"
        />
        <button
          id="save-score"
          class="rounded-md bg-accent px-3 py-1.5 text-sm font-medium text-white transition-colors hover:bg-accent-hover disabled:opacity-50"
        >
          Save score
        </button>
        <span id="save-status" class="text-sm text-text-muted" aria-live="polite"></span>
      </div>
      <p class="mt-3 text-sm text-text-muted">Press Space or tap the canvas to play again.</p>
    </div>

    <section class="mt-12">
      <h2 class="text-lg font-semibold tracking-tight text-text">High scores</h2>
      <p id="lb-mode" class="mt-1 text-sm text-text-muted"></p>
      <ol id="lb-list" class="mt-4 flex flex-col gap-1.5"></ol>
    </section>
  </div>
</BaseLayout>

<style>
  kbd {
    border: 1px solid var(--border);
    border-radius: 0.25rem;
    background: var(--bg-elevated);
    padding: 0.05rem 0.35rem;
    font-size: 0.8em;
  }
</style>

<script>
  import { leaderboardConfig } from "../data/leaderboard";

  // --- DOM ---
  const canvas = document.getElementById("game-canvas");
  const ctx = canvas.getContext("2d");
  const hudScore = document.getElementById("hud-score");
  const hudBest = document.getElementById("hud-best");
  const panel = document.getElementById("gameover-panel");
  const finalScore = document.getElementById("final-score");
  const saveRow = document.getElementById("save-row");
  const nameInput = document.getElementById("player-name");
  const saveBtn = document.getElementById("save-score");
  const saveStatus = document.getElementById("save-status");
  const lbMode = document.getElementById("lb-mode");
  const lbList = document.getElementById("lb-list");

  // --- Canvas setup (logical 640x240, hi-DPI aware) ---
  const W = 640;
  const H = 240;
  const GROUND = H - 32;
  const dpr = Math.min(window.devicePixelRatio || 1, 2);
  canvas.width = W * dpr;
  canvas.height = H * dpr;
  ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

  // Colors come from the site theme so the game follows light/dark mode.
  function readColors() {
    const s = getComputedStyle(document.documentElement);
    return {
      accent: s.getPropertyValue("--accent").trim() || "#0d9488",
      text: s.getPropertyValue("--text").trim() || "#1c1917",
      muted: s.getPropertyValue("--text-muted").trim() || "#57534e",
      border: s.getPropertyValue("--border").trim() || "#e7e5e4",
    };
  }
  let colors = readColors();
  new MutationObserver(() => {
    colors = readColors();
  }).observe(document.documentElement, { attributes: true, attributeFilter: ["class"] });

  // --- Game state ---
  let state = "idle"; // idle | running | over
  let player = { y: GROUND, vy: 0 };
  let obstacles = [];
  let speed = 260;
  let score = 0;
  let elapsed = 0;
  let dashOffset = 0;
  let distToNext = 300;
  let overAt = 0;
  let saved = false;
  let best = Number(localStorage.getItem("synapse.best") || 0);
  hudBest.textContent = String(best);

  function reset() {
    player = { y: GROUND, vy: 0 };
    obstacles = [];
    speed = 260;
    score = 0;
    elapsed = 0;
    dashOffset = 0;
    distToNext = 300;
    saved = false;
  }

  function start() {
    reset();
    panel.classList.add("hidden");
    hudScore.textContent = "0";
    state = "running";
  }

  function act() {
    if (state === "running") {
      if (player.y >= GROUND - 0.5) player.vy = -700;
    } else if (state === "idle") {
      start();
    } else if (state === "over" && performance.now() - overAt > 500) {
      start();
    }
  }

  function gameOver() {
    state = "over";
    overAt = performance.now();
    const s = Math.floor(score);
    if (s > best) {
      best = s;
      localStorage.setItem("synapse.best", String(best));
      hudBest.textContent = String(best);
    }
    finalScore.textContent = String(s);
    saveStatus.textContent = "";
    saveBtn.disabled = false;
    saveRow.classList.toggle("hidden", s <= 0);
    nameInput.value = localStorage.getItem("synapse.name") || "";
    panel.classList.remove("hidden");
  }

  // --- Update & draw ---
  function update(dt) {
    elapsed += dt;
    speed = Math.min(260 + elapsed * 9, 620);
    score += speed * dt * 0.06;
    hudScore.textContent = String(Math.floor(score));
    dashOffset = (dashOffset + speed * dt) % 34;

    player.vy += 2200 * dt;
    player.y += player.vy * dt;
    if (player.y > GROUND) {
      player.y = GROUND;
      player.vy = 0;
    }

    distToNext -= speed * dt;
    if (distToNext <= 0) {
      obstacles.push({ x: W + 20, w: 10 + Math.random() * 10, h: 24 + Math.random() * 26 });
      distToNext = 220 + Math.random() * 240 + speed * 0.25;
    }
    for (const o of obstacles) o.x -= speed * dt;
    while (obstacles.length && obstacles[0].x + obstacles[0].w < -20) obstacles.shift();

    const px = 80;
    const py = player.y - 12;
    const r = 12;
    for (const o of obstacles) {
      const oy = GROUND - o.h;
      const cx = Math.max(o.x, Math.min(px, o.x + o.w));
      const cy = Math.max(oy, Math.min(py, GROUND));
      if ((px - cx) * (px - cx) + (py - cy) * (py - cy) < r * r) {
        gameOver();
        return;
      }
    }
  }

  function draw() {
    ctx.clearRect(0, 0, W, H);

    // Axon: dashed myelin line that scrolls with the run
    ctx.strokeStyle = colors.border;
    ctx.lineWidth = 3;
    ctx.setLineDash([22, 12]);
    ctx.lineDashOffset = dashOffset;
    ctx.beginPath();
    ctx.moveTo(0, GROUND + 14);
    ctx.lineTo(W, GROUND + 14);
    ctx.stroke();
    ctx.setLineDash([]);

    // Blockers
    ctx.fillStyle = colors.muted;
    for (const o of obstacles) {
      ctx.fillRect(o.x, GROUND - o.h, o.w, o.h);
    }

    // The impulse (player) with a small trail
    const py = player.y - 12;
    for (let i = 3; i >= 1; i--) {
      ctx.globalAlpha = 0.12 * i;
      ctx.fillStyle = colors.accent;
      ctx.beginPath();
      ctx.arc(80 - i * 10, py + i * 1.5, 12 - i * 2, 0, Math.PI * 2);
      ctx.fill();
    }
    ctx.globalAlpha = 1;
    ctx.fillStyle = colors.accent;
    ctx.beginPath();
    ctx.arc(80, py, 12, 0, Math.PI * 2);
    ctx.fill();

    if (state === "idle") {
      ctx.fillStyle = colors.muted;
      ctx.font = "600 16px 'Inter Variable', Inter, sans-serif";
      ctx.textAlign = "center";
      ctx.fillText("Press Space or tap to start", W / 2, H / 2 - 10);
    }
  }

  let last = performance.now();
  function frame(now) {
    const dt = Math.min((now - last) / 1000, 0.05);
    last = now;
    if (state === "running") update(dt);
    draw();
    requestAnimationFrame(frame);
  }
  requestAnimationFrame(frame);

  // --- Input ---
  window.addEventListener("keydown", (e) => {
    const t = e.target;
    if (t instanceof HTMLInputElement || t instanceof HTMLTextAreaElement) return;
    if (e.code === "Space" || e.code === "ArrowUp") {
      e.preventDefault();
      act();
    }
  });
  canvas.addEventListener("pointerdown", (e) => {
    e.preventDefault();
    act();
  });

  // --- Leaderboard (shared via Supabase when configured, else this browser only) ---
  const cfg = leaderboardConfig;
  const shared = Boolean(cfg.supabaseUrl && cfg.supabaseAnonKey);
  // Legacy anon keys are JWTs and want an Authorization header; new
  // sb_publishable_* keys are sent via the apikey header alone.
  const apiHeaders = { apikey: cfg.supabaseAnonKey };
  if (cfg.supabaseAnonKey.startsWith("eyJ")) {
    apiHeaders.Authorization = "Bearer " + cfg.supabaseAnonKey;
  }
  lbMode.textContent = shared
    ? "Global leaderboard — top 10 runs from everyone who plays."
    : "Scores are saved in your browser for now.";

  function localScores() {
    try {
      return JSON.parse(localStorage.getItem("synapse.scores") || "[]");
    } catch {
      return [];
    }
  }

  async function fetchTop() {
    if (shared) {
      const res = await fetch(
        cfg.supabaseUrl + "/rest/v1/scores?select=name,score&order=score.desc&limit=10",
        { headers: apiHeaders },
      );
      if (!res.ok) throw new Error("leaderboard fetch failed");
      return res.json();
    }
    return localScores()
      .sort((a, b) => b.score - a.score)
      .slice(0, 10);
  }

  function saveLocal(name, scoreVal) {
    const list = localScores();
    list.push({ name, score: scoreVal });
    list.sort((a, b) => b.score - a.score);
    localStorage.setItem("synapse.scores", JSON.stringify(list.slice(0, 50)));
  }

  async function submitScore(name, scoreVal) {
    if (shared) {
      const res = await fetch(cfg.supabaseUrl + "/rest/v1/scores", {
        method: "POST",
        headers: { ...apiHeaders, "Content-Type": "application/json", Prefer: "return=minimal" },
        body: JSON.stringify([{ name, score: scoreVal }]),
      });
      if (!res.ok) throw new Error("score submit failed");
      return;
    }
    saveLocal(name, scoreVal);
  }

  const MEDALS = ["🥇", "🥈", "🥉"];
  async function renderBoard() {
    try {
      const rows = await fetchTop();
      lbList.innerHTML = "";
      if (!rows.length) {
        const li = document.createElement("li");
        li.className = "text-sm text-text-muted";
        li.textContent = "No scores yet — set the first one!";
        lbList.appendChild(li);
        return;
      }
      rows.forEach((r, i) => {
        const li = document.createElement("li");
        li.className =
          "flex items-center justify-between rounded-lg border border-border px-3 py-1.5 text-sm";
        const left = document.createElement("span");
        left.className = "text-text";
        left.textContent = `${MEDALS[i] || `${i + 1}.`} ${String(r.name).slice(0, 20)}`;
        const right = document.createElement("b");
        right.className = "font-semibold text-accent";
        right.textContent = String(r.score);
        li.append(left, right);
        lbList.appendChild(li);
      });
    } catch {
      lbList.innerHTML = "";
      const li = document.createElement("li");
      li.className = "text-sm text-text-muted";
      li.textContent = "Couldn't load the leaderboard.";
      lbList.appendChild(li);
    }
  }
  renderBoard();

  async function onSave() {
    const s = Math.floor(score);
    if (saved || s <= 0) return;
    const name = (nameInput.value.trim() || "Anon").slice(0, 20);
    saved = true;
    saveBtn.disabled = true;
    localStorage.setItem("synapse.name", name);
    saveStatus.textContent = "Saving…";
    try {
      await submitScore(name, s);
      saveStatus.textContent = "Saved ✓";
    } catch {
      saveLocal(name, s);
      saveStatus.textContent = "Network hiccup — saved on this device.";
    }
    renderBoard();
  }
  saveBtn.addEventListener("click", onSave);
  nameInput.addEventListener("keydown", (e) => {
    e.stopPropagation();
    if (e.key === "Enter") onSave();
  });

  // Tiny hook for automated testing; harmless in production.
  window.__synapseDebug = {
    act,
    gameOver,
    step(dt) {
      if (state === "running") update(dt);
    },
    get state() {
      return state;
    },
    get score() {
      return score;
    },
  };
</script>
